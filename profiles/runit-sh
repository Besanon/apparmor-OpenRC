abi <abi/4.0>,

include <tunables/global>

@{exec_path} =  @{lib}/openrc/sh/runit.sh 
profile runit @{exec_path} flags=(complain) {
  include <abstractions/base>
  include <abstractions/nameservice>
  
  capability mknod,

  @{lib}/openrc/sh/runit.sh		r,

  @{shells_path}					mr,
  @{bin}/rmdir				Cx,	

  /dev/tty						rw,
  
  profile rmdir @{bin}/rmdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/openrc/**			w,
   
  }

 include if exists <local/runit-sh>
}

# vim:syntax=apparmor
