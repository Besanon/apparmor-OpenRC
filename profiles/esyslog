abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/openrc/bin/esyslog 
profile esyslog @{exec_path} {
  include <abstractions/base>
  include <abstractions/ncurses>

  @{exec_path}				mr,
  
  /dev/tty@{int}					rw,
  /dev/console						rw,
  /dev/pts/@{int}					rw,

  deny /apparmor/.null					rw,	# flags=(attach_disconnected)
  deny /etc/conf.d/dmcrypt				r,	# sys-fs/cryptsetup

  include if exists <local/esyslog>
}

# vim:syntax=apparmor

