abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/openrc/bin/veindent
profile veindent @{exec_path} {
  include <abstractions/base>

  @{exec_path}				mr,
  
  /dev/tty@{int}					rw,
  /dev/console						rw,
  /dev/pts/@{int}					rw,

  deny /apparmor/.null					rw,

  include if exists <local/veindent>
}

# vim:syntax=apparmor

