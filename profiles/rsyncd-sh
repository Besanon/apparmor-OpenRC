abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/rsyncd
profile rsyncd-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{exec_path} r,

  @{bin}/rsyncd rPx,

  @{sys}/fs/cgroup/openrc/syncd/tasks          w,
  @{sys}/fs/cgroup/unified/syncd/cgroup.procs  w,
  @{sys}/fs/cgroup/unified/syncd/cgroup.events r,

  include if exists <local/rsyncd-sh>
}

# vim:syntax=apparmor
