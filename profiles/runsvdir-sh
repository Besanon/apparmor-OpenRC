abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/runsvdir
profile runsvdir-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{shells_path}				Cx,
  /bin/mkdir				Cx,	
  /bin/grep				Cx,
  /bin/rmdir				Cx,	
  /etc/{conf,init}.d/runsvdir				r,

  /sys/fs/cgroup/openrc/runsvdir/tasks		w,
  /sys/fs/cgroup/unified/runsvdir/cgroup.procs	w,
  /sys/fs/cgroup/unified/runsvdir/cgroup.events	r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openrc-shell>
  }
  
  profile mkdir /bin/mkdir flags=(complain) {
    include <abstractions/base>

    capability dac_override,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
    /sys/fs/cgroup/{openrc,unified}/runsvdir/	w,

    /bin/mkdir						mr,
  }
  
  profile grep /bin/grep flags=(complain) {
    include <abstractions/base>

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
    /sys/fs/cgroup/unified/runsvdir/cgroup.procs	r,

    /bin/grep						mr,
  }
  
  profile rmdir /bin/rmdir flags=(complain) {
    include <abstractions/base>

    capability dac_override,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
    /sys/fs/cgroup/unified/runsvdir/		w,   

    /bin/rmdir						mr,
  }

  include if exists <local/runsvdir-sh>
}

# vim:syntax=apparmor
