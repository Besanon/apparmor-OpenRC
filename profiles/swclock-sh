abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/swclock
profile swclock-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>

  @{shells_path}				Cx,
  @{bin}/uname					Px,	
  @{bin}/mkdir					Cx,	
  @{bin}/grep					Cx,
  @{bin}/rmdir					Cx,	
  @{sbin}/swclock				Px,	
  
  /etc/{conf,init}.d/swclock				r,

  @{run}/openrc/daemons/**/001 r,
  @{run}/openrc/exclusive/* rwk,
  @{run}/openrc/exclusive/localmount r,
  @{run}/openrc/exclusive/save-termencoding r,
  @{run}/openrc/exclusive/unbound rwk,
  @{run}/openrc/exclusive/root r,
  @{run}/openrc/exclusive/fsck r,
  @{run}/openrc/started/swclock rw,
  @{run}/openrc/stopping/swclock rw,
  @{run}/openrc/exclusive/NetworkManager rwk,
  @{run}/supervise-*.pid r,

  /dev/							r,
  @{sys}/fs/cgroup/openrc/swclock/tasks		w,
  @{sys}/fs/cgroup/unified/swclock/cgroup.procs	w,
  @{sys}/fs/cgroup/unified/swclock/cgroup.events	r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice-strict>
    include <abstractions/openrc-shell>
  }
  
  profile mkdir @{bin}/mkdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/mkdir						mr,

    @{sys}/fs/cgroup/{openrc,unified}/hwclock/	w,
    
    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,    
  }
  
  profile grep @{bin}/grep flags=(complain) {
    include <abstractions/base>
    
    @{bin}/grep						mr,

    @{sys}/fs/cgroup/unified/hwclock/cgroup.procs	r,

    @{PROC}/devices					r,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,    
  }
  
  profile rmdir @{bin}/rmdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/unified/hwclock/			w,
    
    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,    
  }

  include if exists <local/swclock-sh>
}

# vim:syntax=apparmor
