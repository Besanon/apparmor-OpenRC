abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/power-profiles-daemon
profile power-profiles-daemon-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{shells_path}				Cx,
  @{bin}/mkdir				Cx,	
  @{bin}/grep				Cx,	
  @{bin}/rmdir				Cx,	
  /etc/{conf,init}.d/power-profiles-daemon				r,

  @{sys}/fs/cgroup/openrc/power-profiles-daemon/tasks		w,
  @{sys}/fs/cgroup/unified/power-profiles-daemon/cgroup.procs	w,
  @{sys}/fs/cgroup/unified/power-profiles-daemon/cgroup.events	r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openrc-shell>
  }
  
  profile mkdir @{bin}/mkdir flags=(complain) {
    include <abstractions/base>

    capability dac_override,

    @{bin}/mkdir						mr,

    @{sys}/fs/cgroup/{openrc,unified}/power-profiles-daemon/	w,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }
  
  profile grep @{bin}/grep flags=(complain) {
    include <abstractions/base>

    @{bin}/grep						mr,

    @{sys}/fs/cgroup/unified/power-profiles-daemon/cgroup.procs	r,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }
  
  profile rmdir @{bin}/rmdir flags=(complain) {
    include <abstractions/base>

    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/unified/power-profiles-daemon/		w,   

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }

  include if exists <local/power-profiles-daemon-sh>
}

# vim:syntax=apparmor
