abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/mdraid
profile mdraid-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  /etc/{conf,init}.d/mdraid   r,

  @{run}/NetworkManager/NetworkManager.pid r,
  @{run}/openrc/daemons/cupsd/001 r,
  @{run}/openrc/started/mdraid rw,
  @{run}/openrc/stopping/mdraid rw,
  @{run}/openrc/daemons/mdraid/001 r,
  @{run}/openrc/daemons/NetworkManager/001 r,
  @{run}/supervise-*.pid r,

  @{sys}/fs/cgroup/openrc/mdraid/tasks                    w,
  @{sys}/fs/cgroup/unified/mdraid/cgroup.procs            w,
  @{sys}/fs/cgroup/unified/mdraid/cgroup.events           r,

  include if exists <local/mdraid-sh>
}

# vim:syntax=apparmor
