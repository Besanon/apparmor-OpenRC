abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/openrc/bin/service_*
profile service_all @{exec_path} flags=(attach_disconnected, complain) {

profile  @{lib}/openrc/bin/service_* flags=(attach_disconnected) {
  include <abstractions/base>
  
  capability kill,
  capability sys_ptrace,
  
  ptrace (trace),
  
  @{PROC}/						r,
  @{PROC}/@{pids}/cmdline				r,
  
  @{exec_path} 				mr,

  @{run}/openrc/   r,
  @{run}/openrc/**/ r,
  @{run}/openrc/daemons/{,**}				r,
  @{run}/**.pid						r,

  /dev/tty@{int}                                        rw,
  /dev/console                                          rw,
  /dev/pts/@{int}                                       rw,
  
  deny /apparmor/.null					rw,	
  
  include if exists <local/service_all>
}

# vim:syntax=apparmor
