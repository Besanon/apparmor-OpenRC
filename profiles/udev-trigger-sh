abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/udev-trigger
profile udev-trigger-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{shells_path}				Cx,
  @{bin}/udevadm					Px,
  @{bin}/mkdir					Cx,	
  @{bin}/grep					Cx,	
  @{bin}/rmdir					Cx,	
  @{bin}/cat					Cx,	

  /etc/init.d/netmount Px,
  /etc/{conf,init}.d/udev-trigger			r,
  @{run}/udev/rules.d/*.rules				w,

  @{bin}/openrc-run r,

  /etc/{conf,init}.d/udev-trigger   r,

  @{run}/openrc/daemons/avahi-daemon/001 r,
  @{run}/openrc/daemons/cupsd/001 r,
  @{run}/openrc/daemons/elogind/001 r,
  @{run}/openrc/daemons/dbus/001 r,
  @{run}/udev-trigger/udev-trigger.pid r,
  @{run}/openrc/exclusive/netmount rwk,
  @{run}/openrc/exclusive/unbound rwk,
  @{run}/openrc/inactive/udev-trigger rw,
  @{run}/openrc/starting/udev-trigger rw,
  @{run}/openrc/started/udev-trigger rw,
  @{run}/openrc/stopping/udev-trigger rw,
  @{run}/openrc/wasinactive/udev-trigger rw,
  @{run}/openrc/daemons/udev-trigger/001 r,
  @{run}/supervise-*.pid r,
 
  @{sys}/fs/cgroup/openrc/udev-trigger/tasks                      w,
  @{sys}/fs/cgroup/unified/udev-trigger/cgroup.procs              w,
  @{sys}/fs/cgroup/unified/udev-trigger/cgroup.events             r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openrc-shell>
  }
  
  profile mkdir @{bin}/mkdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/mkdir						mr,

    @{sys}/fs/cgroup/{openrc,unified}/udev-trigger/	w,

    @{run}/udev/rules.d/					w,
    
    /dev/tty[0-9]*					rw,
    /dev/console					rw,
    /dev/pts/[0-9]*					rw,    
  }
  
  profile grep @{bin}/grep flags=(complain) {
    include <abstractions/base>

    @{bin}/grep						mr,

    @{sys}/fs/cgroup/unified/udev-trigger/cgroup.procs r,
    
    /dev/tty[0-9]*					rw,
    /dev/console					rw,
    /dev/pts/[0-9]*					rw,    
  }
  
  profile rmdir @{bin}/rmdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/unified/udev-trigger/		w,
    
    /dev/tty[0-9]*					rw,
    /dev/console					rw,
    /dev/pts/[0-9]*					rw,    
  }
  
  profile cat @{bin}/cat flags=(complain) {
    include <abstractions/base>

    @{bin}/cat						mr,

    @{PROC}/cmdline					r,
    
    /dev/tty[0-9]*					rw,
    /dev/console					rw,
    /dev/pts/[0-9]*					rw,
  }

  include if exists <local/udev-trigger-sh>
}

# vim:syntax=apparmor
