abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/binfmt
profile binfmt-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{shells_path}       Cx,

  @{bin}/binfmt rPx,

  @{exec_path} r,
  
  @{run}/openrc/started/binfmt rw,
  @{run}/openrc/stopping/binfmt rw,
  @{run}/openrc/exclusive/binfmt rw,
  @{run}/openrc/scheduled/NetworkManager/ rw,

  @{sys}/fs/cgroup/openrc/binfmt/tasks                    w,
  @{sys}/fs/cgroup/unified/binfmt/cgroup.procs            w,
  @{sys}/fs/cgroup/unified/binfmt/cgroup.events           r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openrc-shell>
  }

  include if exists <local/binfmt-sh>
}

# vim:syntax=apparmor
