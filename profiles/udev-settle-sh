abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/udev-settle
profile udev-settle-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{shells_path}				Cx,
  @{bin}/udevadm					Px,	
  @{bin}/mkdir					Cx,	
  @{bin}/grep					Cx,	
  @{bin}/rmdir					Cx,	
  /etc/init.d/netmount Px,
  /etc/{conf,init}.d/udev-settle   r,

  @{run}/openrc/daemons/avahi-daemon/001 r,
  @{run}/openrc/daemons/cupsd/001 r,
  @{run}/openrc/daemons/elogind/001 r,
  @{run}/openrc/daemons/dbus/001 r,
  @{run}/udev-settle/udev-settle.pid r,
  @{run}/openrc/exclusive/netmount rwk,
  @{run}/openrc/exclusive/unbound rwk,
  @{run}/openrc/inactive/udev-settle rw,
  @{run}/openrc/starting/udev-settle rw,
  @{run}/openrc/started/udev-settle rw,
  @{run}/openrc/stopping/udev-settle rw,
  @{run}/openrc/wasinactive/udev-settle rw,
  @{run}/openrc/daemons/udev-settle/001 r,
  @{run}/supervise-*.pid r,
 
  @{sys}/fs/cgroup/openrc/udev-settle/tasks                      w,
  @{sys}/fs/cgroup/unified/udev-settle/cgroup.procs              w,
  @{sys}/fs/cgroup/unified/udev-settle/cgroup.events             r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openrc-shell>
  }
  
  profile mkdir @{bin}/mkdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/mkdir						mr,

    @{sys}/fs/cgroup/{openrc,unified}/udev-settle/	w,
    
    /dev/tty[0-9]*					rw,
    /dev/console					rw,
    /dev/pts/[0-9]*					rw,    
  }
  
  profile grep @{bin}/grep flags=(complain) {
    include <abstractions/base>

    @{bin}/grep						mr,

    @{sys}/fs/cgroup/unified/udev-settle/cgroup.procs	r,
    
    /dev/tty[0-9]*					rw,
    /dev/console					rw,
    /dev/pts/[0-9]*					rw,    
  }
  
  profile rmdir @{bin}/rmdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/unified/udev-settle/		w,
    
    /dev/tty[0-9]*					rw,
    /dev/console					rw,
    /dev/pts/[0-9]*					rw,    
  }

  include if exists <local/udev-settle-sh>
}

# vim:syntax=apparmor
