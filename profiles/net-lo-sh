abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/net.lo
profile net.lo-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  /etc/{conf,init}.d/net.lo   r,

  @{run}/NetworkManager/NetworkManager.pid r,
  @{run}/openrc/exclusive/net.lo rw,
  @{run}/openrc/started/net.lo rw,
  @{run}/openrc/stopping/net.lo rw,
  @{run}/openrc/options/net.lo/ rw,
  @{run}/openrc/options/net.lo/nodev_routes rw,
  @{run}/openrc/daemons/net.lo/001 r,
  @{run}/openrc/daemons/NetworkManager/001 r,
  @{run}/supervise-*.pid r,
  @{run}/openrc/scheduled/NetworkManager/ rw,

  @{sys}/fs/cgroup/openrc/net.lo/tasks                    w,
  @{sys}/fs/cgroup/unified/net.lo/cgroup.procs            w,
  @{sys}/fs/cgroup/unified/net.lo/cgroup.events           r,

  include if exists <local/net.lo-sh>
}

# vim:syntax=apparmor
