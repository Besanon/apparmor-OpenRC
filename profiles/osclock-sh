abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/osclock
profile osclock-sh @{exec_path} flags=(complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  signal receive set=hup peer=@{p_systemd},

  @{exec_path} mr,

  @{run}/osclock/osclock.pid r,
  @{run}/openrc/started/osclock rw,
  @{run}/openrc/stopping/osclock rw,
  @{run}/openrc/daemons/osclock/001 r,
  @{run}/openrc/daemons/osclock/001 r,
  @{run}/supervise-*.pid r,

  @{sys}/fs/cgroup/openrc/osclock/tasks                      w,
  @{sys}/fs/cgroup/unified/osclock/cgroup.procs              w,
  @{sys}/fs/cgroup/unified/osclock/cgroup.events             r,

  include if exists <local/osclock-sh>
}

# vim:syntax=apparmor
