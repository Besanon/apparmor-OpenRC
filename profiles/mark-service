abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/openrc/sbin/mark_*
profile mark_service @{exec_path} {
  include <abstractions/base>
  include <abstractions/nameservice-strict>

  signal send set=usr1 peer=unconfined,
  signal send set=usr1 peer=NetworkManager,
  signal send set=usr1 peer=NetworkManager-sh,
  signal send set=usr1 peer=rc-service,

  @{exec_path} mr,

  @{run}/openrc/  r,
  @{run}/openrc/exclusive/ r,
  @{run}/openrc/exclusive/* rw,
  @{run}/openrc/started/  r,
  @{run}/openrc/inactive/  r,
  @{run}/openrc/starting/  r,
  @{run}/openrc/stopping/  r,
  @{run}/openrc/stopping/NetworkManager rw,
  @{run}/openrc/wasinactive/  r,
  @{run}/openrc/hotplugged/  r,
  @{run}/openrc/failed/  r,
  @{run}/openrc/scheduled/  r,
  @{run}/openrc/inactive/* rw,
  @{run}/openrc/starting/* rw,

  /dev/pts/@{int} rw,

  include if exists <local/mark_service>
}

# vim:syntax=apparmor
