abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{sbin}/supervise-daemon
profile supervise-daemon @{exec_path} {
  include <abstractions/base>
  include <abstractions/avahi-observe>
  include <abstractions/nameservice-strict>

  capability chown,
  capability dac_override,
  capability kill,
  capability setgid,
  capability setuid,
  capability sys_chroot,
  capability net_admin,
  capability sys_ptrace,

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network inet raw,
  network inet6 raw,
  network netlink raw,
  network packet dgram,
  
  signal send set=term,

  ptrace read,

  unix type=dgram,
  unix type=stream,

  #aa:dbus own bus=system name=org.freedesktop.systemd1
    
  @{exec_path}    				mrix,

  @{lib}/openrc/bin/openrc-user mr,

  @{bin}/*   				rPx,
  @{sbin}/*	        		rPx,	

  @{lib}/at-spi-bus-launcher rPx,
  @{lib}/gvfsd rPx,
  @{lib}/gvfs-gphoto2-volume-monitor rPx,
  @{lib}/gvfs-mtp-volume-monitor rPx,
  @{lib}/openrc/bin/openrc-user.sh rPx, 
  @{lib}/openrc/bin/openrc-user rPx,

  /etc/avahi/avahi-daemon.conf r,
  /etc/avahi/services/ r,
  /etc/avahi/hosts r,

  /usr/share/dbus-1/services/ r,
  /usr/share/dbus-1/services/*.service r,
  /usr/share/dbus-1/session.conf r,
  /usr/share/dbus-1/session.d/ r,
  /usr/share/dbus-1/session.d/* r,

  @{run}/agetty.*.pid					rw,
  @{run}/avahi-daemon/ rw,
  @{run}/avahi-daemon/socket rw,
  @{run}/openrc/ r,
  @{run}/openrc/{,**} rwk,
  @{run}/supervise-*.pid rw,
  @{run}/systemd/users/@{uid} r,
    /run/openrc/daemons/agetty.*/{,**}                  rw,
    /run/openrc/options/agetty.*/{,**}                  rw,
    /run/openrc/scheduled/                              r,
    /run/openrc/stopping/agetty.*                       w,
    /run/openrc/exclusive/agetty.*                      w,
  owner @{run}/avahi-daemon/pid rwk,
  owner @{run}/user/@{uid}/bus rw,
  owner @{run}/user/@{uid}/dbus-1/ rw,
  owner @{run}/user/@{uid}/dbus-1/services/ rw,
  owner @{run}/user/@{uid}/openrc/ r, 
  owner @{run}/user/@{uid}/openrc/{,**} rwk,
  owner @{run}/user/@{uid}/supervise-*.pid rwk,

  @{PROC}/ r,
  @{PROC}/@{pid}/cmdline r,
  owner @{PROC}/@{pid}/cmdline r,
  owner @{PROC}/@{pid}/fdinfo/@{int} r,  
  owner @{PROC}/@{pid}/oom_score_adj r,

  /dev/tty                                              rw,
  /dev/tty@{int}                                        rw,
  /dev/console                                  rw,
  /dev/pts/@{int}                                       rw,
  
  include if exists <local/supervise-daemon>
}

# vim:syntax=apparmor
