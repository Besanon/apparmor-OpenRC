abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/ip6tables
profile ip6tables-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{exec_path} r,

  @{bin}/ip6tables Px,

  @{sys}/fs/cgroup/openrc/ip6tables/tasks                    w,
  @{sys}/fs/cgroup/unified/ip6tables/cgroup.procs            w,
  @{sys}/fs/cgroup/unified/ip6tables/cgroup.events           r,

  include if exists <local/ip6tables-sh>
}

# vim:syntax=apparmor
