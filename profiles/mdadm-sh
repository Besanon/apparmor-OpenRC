abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/mdadm
profile mdadm-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{exec_path} r,

  @{bin}/mdadm Px, 

  @{sys}/fs/cgroup/openrc/mdadm/tasks                    w,
  @{sys}/fs/cgroup/unified/mdadm/cgroup.procs            w,
  @{sys}/fs/cgroup/unified/mdadm/cgroup.events           r,

  include if exists <local/mdadm-sh>
}

# vim:syntax=apparmor
