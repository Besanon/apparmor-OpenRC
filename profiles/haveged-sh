abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/haveged
profile haveged-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{exec_path} r,

  @{bin}/haveged Px,

  @{sys}/fs/cgroup/openrc/haveged/tasks                    w,
  @{sys}/fs/cgroup/unified/haveged/cgroup.procs            w,
  @{sys}/fs/cgroup/unified/haveged/cgroup.events           r,

  include if exists <local/haveged-sh>
}

# vim:syntax=apparmor
