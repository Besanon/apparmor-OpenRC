abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/openrc/bin/service_set_value
profile service_set_value @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>

  @{exec_path}			mr,

  @{run}/openrc/ r,
  @{run}/openrc/options/ r,
  @{run}/openrc/options/agetty.tty@{int} rw,
  @{run}/openrc/options/**				rw,
  
  /dev/tty						rw,
  /dev/tty@{int}					rw,
  /dev/console						rw,
  /dev/pts/@{int}					rw,

  include if exists <local/service_set_value>
}

# vim:syntax=apparmor
