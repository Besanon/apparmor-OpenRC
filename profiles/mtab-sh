abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/mtab
profile mtab-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{shells_path}			Cx,
  @{bin}/ln				Cx,	
  @{bin}/mkdir				Cx,	
  @{bin}/grep				Cx,
  @{bin}/rmdir				Cx,	
  
  /etc/{conf,init}.d/mtab				r,

  @{run}/NetworkManager/NetworkManager.pid r,
  @{run}/openrc/exclusive/mtab rw,
  @{run}/openrc/started/mtab rw,
  @{run}/openrc/stopping/mtab rw,
  @{run}/openrc/daemons/mtab/001 r,
  @{run}/openrc/daemons/NetworkManager/001 r,
  @{run}/openrc/scheduled/NetworkManager/ rw,
  @{run}/supervise-*.pid r,

  @{sys}/fs/cgroup/openrc/mtab/tasks			w,
  @{sys}/fs/cgroup/unified/mtab/cgroup.procs		w,
  @{sys}/fs/cgroup/unified/mtab/cgroup.events		r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice-strict>
    include <abstractions/openrc-shell>
  }
  
  profile ln @{bin}/ln flags=(complain) {
    include <abstractions/base>

    @{bin}/ln						mr,

    /etc/mtab						w,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,    
  }
  
  profile mkdir @{bin}/mkdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/mkdir						mr,

    @{sys}/fs/cgroup/{openrc,unified}/mtab/		w,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,    
  }
  
  profile grep @{bin}/grep flags=(complain) {
    include <abstractions/base>

    @{bin}/grep						mr,

    @{sys}/fs/cgroup/unified/mtab/cgroup.procs	r,
    
    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,    
  }
  
  profile rmdir @{bin}/rmdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/unified/mtab/			w,
    
    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,    
  }

  include if exists <local/mtab-sh>
}

# vim:syntax=apparmor
