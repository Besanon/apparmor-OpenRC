abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/iptables
profile iptables-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{exec_path} r,

  @{bin}/iptables Px,

  @{run}/openrc/exclusive/iptables rw,
  @{run}/openrc/started/iptables rw,
  @{run}/openrc/stopping/iptables rw,
  @{run}/openrc/scheduled/NetworkManager/ rw,

  @{sys}/fs/cgroup/openrc/iptables/tasks                    w,
  @{sys}/fs/cgroup/unified/iptables/cgroup.procs            w,
  @{sys}/fs/cgroup/unified/iptables/cgroup.events           r,

  include if exists <local/iptables-sh>
}

# vim:syntax=apparmor
