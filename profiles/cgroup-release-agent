abi <abi/4.0>,

include <tunables/global>

@{exec_path} =  @{lib}/openrc/sh/cgroup-release-agent.sh 
profile cgroup-release-agent @{exec_path} {
  include <abstractions/base>
  include <abstractions/nameservice>
  
  capability mknod,

  @{exec_path}		r,

  @{shells_path}					mr,
  @{bin}/rmdir				Cx,	

  /dev/tty						rw,
  
  profile rmdir @{bin}/rmdir {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/openrc/**			w,
   
  }

  include if exists <local/cgroup-release-agent>
}

# vim:syntax=apparmor
