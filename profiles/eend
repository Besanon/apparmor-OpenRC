abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/openrc/bin/eend
profile eend @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/ncurses>

  capability sys_tty_config,
  capability mknod,

  @{exec_path}				mr,

  @{run}/openrc/exclusive/pam_openr* rw,
  
  /dev/tty						rw,
  /dev/tty@{int}					rw,
  /dev/console						rw,
  /dev/pts/@{int}					rw,

  deny /etc/conf.d/dmcrypt				r,	

  include if exists <local/eend>
}

# vim:syntax=apparmor

