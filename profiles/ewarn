abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/openrc/bin/ewarn{,n} 
profile ewarn @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/ncurses>

  @{exec_path}				mr,
  
  /dev/tty@{int}					rw,
  /dev/console						rw,
  /dev/pts/@{int}					rw,

  deny /apparmor/.null					

  include if exists <local/ewarn>
}

# vim:syntax=apparmor

