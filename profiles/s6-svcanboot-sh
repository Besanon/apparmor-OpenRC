abi <abi/4.0>,

include <tunables/global>

@{exec_path} =  @{lib}/openrc/sh/s6-svscanboot.sh 
profile s6-svscanboot-sh @{exec_path} flags=(complain) {
  include <abstractions/base>
  include <abstractions/nameservice>
  
  capability mknod,

  @{exec_path}		r,

  @{shells_path}					mr,
  /bin/rmdir				Cx,	

  /dev/tty						rw,
  
  profile rmdir /bin/rmdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    /bin/rmdir						mr,

    /sys/fs/cgroup/openrc/**			w,   
  }

 include if exists <local/s6-svscanboot-sh>
}

# vim:syntax=apparmor
