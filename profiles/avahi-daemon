abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/avahi-daemon 
profile avahi-daemon @{exec_path} {
  include <abstractions/base>
  include <abstractions/bus-system>
  include <abstractions/bus/system/org.freedesktop.Avahi.AddressResolver>
  include <abstractions/bus/system/org.freedesktop.Avahi.HostNameResolver>
  include <abstractions/consoles>
  include <abstractions/nameservice-strict>

  network inet dgram,
  network netlink dgram,
  network packet dgram,

  capability chown,
  capability setgid,
  capability setuid,
  capability sys_chroot,

  signal receive set=term peer=supervise-daemon,

  @{exec_path} mr,

  /etc/resolv.conf rw,
  /etc/avahi/avahi-daemon.conf r,
  /etc/avahi/services/ r,
  /etc/avahi/services/* rw,
  /etc/avahi/hosts r,

  @{run}/avahi-daemon/ rw,
  @{run}/avahi-daemon/pid rwk,
  owner @{run}/avahi-daemon/socket rwk,

  include if exists <local/avahi-daemon>
}

# vim:syntax=apparmor
