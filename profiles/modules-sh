abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/modules
profile modules-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  /etc/{conf,init}.d/modules   r,

  @{shells_path}				Cx,
  @{bin}/uname					Px,	# sys-apps/coreutils
  @{bin}/kmod					Px,	# sys-apps/kmod
  @{bin}/mkdir					Cx,	# sys-apps/coreutils
  @{bin}/grep					Cx,	# sys-apps/grep
  @{bin}/rmdir					Cx,	# sys-apps/coreutils

  @{run}/NetworkManager/NetworkManager.pid r,
  @{run}/openrc/exclusive/** rwk,
  @{run}/openrc/started/modules rw,
  @{run}/openrc/stopping/modules rw,
  @{run}/openrc/daemons/modules/001 r,
  @{run}/openrc/daemons/NetworkManager/001 r,
  @{run}/supervise-*.pid r,

  @{sys}/fs/cgroup/openrc/modules/tasks		w,
  @{sys}/fs/cgroup/unified/modules/cgroup.procs	w,
  @{sys}/fs/cgroup/unified/modules/cgroup.events	r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openrc-shell>
  }
  
  profile mkdir @{bin}/mkdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/mkdir						mr,

    @{sys}/fs/cgroup/{openrc,unified}/modules/	w,
    
    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,    
  }
  
  profile grep @{bin}/grep flags=(complain) {
    include <abstractions/base>

    @{bin}/grep						mr,

    @{sys}/fs/cgroup/unified/modules/cgroup.procs	r,
    
    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,    
  }
  
  profile rmdir @{bin}/rmdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/unified/modules/			w,
    
    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }

  include if exists <local/modules-sh>
}

# vim:syntax=apparmor
