abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/device-mapper
profile device-mapper-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  /etc/{conf,init}.d/device-mapper   r,

  @{sys}/fs/cgroup/openrc/device-mapper/tasks                    w,
  @{sys}/fs/cgroup/unified/device-mapper/cgroup.procs            w,
  @{sys}/fs/cgroup/unified/device-mapper/cgroup.events           r,

  include if exists <local/device-mapper-sh>
}

# vim:syntax=apparmor
