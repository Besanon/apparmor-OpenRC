abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/openrc/bin/kill_all 
profile kill_all @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/ncurses>
  
  capability kill,
  
  signal (send),						

  @{exec_path}				mr,
  
  @{PROC}/						r,
  @{PROC}/@{pids}/status				r,

  /dev/tty@{int}					rw,
  /dev/console						rw,

  include if exists <local/kill_all>
}

# vim:syntax=apparmor

