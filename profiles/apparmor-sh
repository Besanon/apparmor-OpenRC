abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/apparmor
profile apparmor-sh @{exec_path} flags=(complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  /etc/{conf,init}.d/apparmor     r,

  @{run}/openrc/exclusive/apparmor rw,
  @{run}/openrc/stopping/apparmor rw,
  @{run}/openrc/started/apparmor rw,

  @{sys}/fs/cgroup/openrc/apparmor/tasks          w,
  @{sys}/fs/cgroup/unified/apparmor/cgroup.procs  w,
  @{sys}/fs/cgroup/unified/apparmor/cgroup.events r,

  include if exists <local/apparmor-sh>
}

# vim:syntax=apparmor
