abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/save-termencoding
profile save-termencoding-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{shells_path}				Cx,
  @{bin}/mkdir				Cx,	
  @{bin}/grep				Cx,
  @{bin}/rmdir				Cx,	
  /etc/init.d/keymaps			Px,
  /etc/init.d/consolefont		Px,
  /etc/init.d/netmount Px,

  @{bin}/openrc-run r,

  /etc/{conf,init}.d/termencoding   r,

  @{lib}/rc/console/unicode			w,
 
  @{run}/openrc/daemons/avahi-daemon/001 r,
  @{run}/openrc/daemons/cupsd/001 r,
  @{run}/openrc/daemons/elogind/001 r,
  @{run}/openrc/daemons/dbus/001 r,
  @{run}/save-termencoding/termencoding.pid r,
  @{run}/openrc/exclusive/netmount rwk,
  @{run}/openrc/exclusive/unbound rwk,
  @{run}/openrc/inactive/save-termencoding rw,
  @{run}/openrc/starting/save-termencoding rw,
  @{run}/openrc/started/save-termencoding rw,
  @{run}/openrc/stopping/save-termencoding rw,
  @{run}/openrc/wasinactive/save-termencoding rw,
  @{run}/openrc/daemons/save-termencoding/001 r,
  @{run}/supervise-*.pid r,
 
  @{sys}/fs/cgroup/openrc/save-termencoding/tasks                      w,
  @{sys}/fs/cgroup/unified/save-termencoding/cgroup.procs              w,
  @{sys}/fs/cgroup/unified/save-termencoding/cgroup.events             r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openrc-shell>
  }
  
  profile mkdir @{bin}/mkdir flags=(complain) {
    include <abstractions/base>

    capability dac_override,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
    @{sys}/fs/cgroup/{openrc,unified}/termencoding/	w,

    @{bin}/mkdir						mr,
    
    @{lib}/rc/console/				w,
  }
  
  profile grep @{bin}/grep flags=(complain) {
    include <abstractions/base>

    @{bin}/grep						mr,

    @{sys}/fs/cgroup/unified/termencoding/cgroup.procs r,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }
  
  profile rmdir @{bin}/rmdir flags=(complain) {
    include <abstractions/base>

    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/unified/termencoding/		w,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }

  include if exists <local/save-termencoding-sh>
}

# vim:syntax=apparmor
