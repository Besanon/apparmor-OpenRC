abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/auditd
profile auditd-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{shells_path}       Cx,
  @{bin}/auditd rPx,
  /etc/{conf,init}.d/auditd       r,

  @{run}/openrc/daemons/auditd/ rw,
  @{run}/openrc/daemons/auditd/001 r,
  @{run}/openrc/exclusive/auditd rw,
  @{run}/openrc/started/auditd rw,
  @{run}/openrc/starting/auditd rw,
  @{run}/openrc/stopping/auditd rw,
  @{run}/openrc/scheduled/NetworkManager/ rw,

  @{sys}/fs/cgroup/openrc/auditd/tasks          w,
  @{sys}/fs/cgroup/unified/auditd/cgroup.procs  w,
  @{sys}/fs/cgroup/unified/auditd/cgroup.events r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openrc-shell>
  }

  include if exists <local/auditd-sh>
}

# vim:syntax=apparmor
