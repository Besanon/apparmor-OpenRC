abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/hostname
profile hostname-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  capability kill,

  @{shells_path}				Cx,
  @{bin}/hostname			Px,	
  @{bin}/mkdir				Cx,	
  @{bin}/grep				Cx,	
  @{bin}/rmdir				Cx,	
  
  /etc/{conf,init}.d/hostname				r,

  @{run}/openrc/daemons/metalog/001 r,
  @{run}/openrc/daemons/acpid/001 r,
  @{run}/openrc/daemons/unbound/001 r,
  @{run}/openrc/exclusive/acpid rwk,
  @{run}/openrc/exclusive/hostname rwk,
  @{run}/openrc/exclusive/metalog rwk,
  @{run}/openrc/exclusive/unbound rwk,
  @{run}/openrc/started/hostname rw,
  @{run}/openrc/stopping/hostname rw,
  @{run}/unbound.pid r,
  @{run}/supervise-*.pid r,

  @{sys}/fs/cgroup/openrc/hostname/tasks                    w,
  @{sys}/fs/cgroup/unified/hostname/cgroup.procs            w,
  @{sys}/fs/cgroup/unified/hostname/cgroup.events           r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/openrc-shell>
  }
  
  profile mkdir @{bin}/mkdir flags=(complain) {
    include <abstractions/base>

    capability dac_override,

    @{bin}/mkdir						mr,

    @{sys}/fs/cgroup/{openrc,unified}/hostname/	w,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }
  
  profile grep @{bin}/grep flags=(complain) {
    include <abstractions/base>

    @{bin}/grep						mr,

    @{sys}/fs/cgroup/unified/hostname/cgroup.procs	r,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }
  
  profile rmdir @{bin}/rmdir flags=(complain) {
    include <abstractions/base>

    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/unified/hostname/		w, 

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }

  include if exists <local/hostname-sh>
}

# vim:syntax=apparmor
