abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/openrc/bin/service_get_value
profile service_get_value @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  
  /dev/tty@{int}					rw,
  /dev/console						rw,
  /dev/pts/@{int}					rw,
  
  @{exec_path}			mr,
  
  @{run}/openrc/options/**				r,
  @{run}/openrc/exclusive/pam_openr* rw,
  owner @{run}/user/@{uid}/openrc/options/dbus/pidfile r,
  owner @{run}/user/@{uid}/openrc/options/wireplumber/pidfile r,
  owner @{run}/user/@{uid}/openrc/options/pipewire/pidfile r,
  owner @{run}/user/@{uid}/openrc/options/pipewire-pulse/pidfile r,

  deny /apparmor/.null					rw,	

  include if exists <local/service_get_value>
}

# vim:syntax=apparmor
