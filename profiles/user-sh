abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/user
profile user-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{shells_path}				Cx,
  @{bin}/mkdir				Cx,	# sys-apps/coreutils
  @{bin}/grep				Cx,	# sys-apps/grep
  @{bin}/rmdir				Cx,	# sys-apps/coreutils
  /etc/{conf,init}.d/user				r,

  @{sys}/fs/cgroup/openrc/user/tasks		w,
  @{sys}/fs/cgroup/unified/user/cgroup.procs	w,
  @{sys}/fs/cgroup/unified/user/cgroup.events	r,

  @{run}/supervise-user.user.pid r,
  @{run}/supervise-user.admin.pid r,
  
  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openrc-shell>
  }
  
  profile mkdir @{bin}/mkdir flags=(complain) {
    include <abstractions/base>

    capability dac_override,

    @{bin}/mkdir						mr,

    @{sys}/fs/cgroup/{openrc,unified}/user/	w,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }
  
  profile grep @{bin}/grep flags=(complain) {
    include <abstractions/base>

    @{bin}/grep						mr,

    @{sys}/fs/cgroup/unified/user/cgroup.procs	r,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }
  
  profile rmdir @{bin}/rmdir flags=(complain) {
    include <abstractions/base>

    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/unified/user/		w,   

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }

  include if exists <local/user-sh>
}

# vim:syntax=apparmor
