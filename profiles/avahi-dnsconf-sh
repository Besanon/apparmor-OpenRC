abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/avahi-dnsconfd
profile avahi-dnsconfd-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{shells_path}       Cx,

  @{bin}/avahi-dnsconfd rPx,
  /etc/{conf,init}.d/avahi-dnsconfd   r,

  @{sys}/fs/cgroup/openrc/avahi-dnsconfd/tasks                    w,
  @{sys}/fs/cgroup/unified/avahi-dnsconfd/cgroup.procs            w,
  @{sys}/fs/cgroup/unified/avahi-dnsconfd/cgroup.events           r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openrc-shell>
  }

  include if exists <local/avahi-dnsconfd-sh>
}

# vim:syntax=apparmor
