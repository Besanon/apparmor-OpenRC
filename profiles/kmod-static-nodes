abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /etc/init.d/kmod-static-nodes
profile kmod-static-nodes-sh @{exec_path} flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/openrc>
  include <abstractions/openrc-scripts>

  @{shells_path}			Cx,
  @{bin}/kmod				Px,
  @{bin}/mkdir				Cx,	
  @{bin}/grep				Cx,
  @{bin}/rmdir				Cx,	
  
  /etc/{conf,init}.d/kmod-static-nodes			r,

  @{run}/NetworkManager/NetworkManager.pid r,
  @{run}/openrc/daemons/cupsd/001 r,
  @{run}/openrc/exclusive/kmod-static-nodes rw,
  @{run}/openrc/scheduled/NetworkManager/ rw,
  @{run}/openrc/started/kmod-static-nodes rw,
  @{run}/openrc/stopping/kmod-static-nodes rw,
  @{run}/openrc/daemons/kmod-static-nodes/001 r,
  @{run}/openrc/daemons/NetworkManager/001 r,
  @{run}/supervise-*.pid r,
  /run/tmpfiles.d/					w,

  @{sys}/fs/cgroup/openrc/kmod-static-nodes/tasks	w,
  @{sys}/fs/cgroup/unified/kmod-static-nodes/cgroup.procs w,
  @{sys}/fs/cgroup/unified/kmod-static-nodes/cgroup.events r,

  profile @{shells_path} flags=(complain) {
    include <abstractions/base>
    include <abstractions/nameservice-strict>
    include <abstractions/openrc-shell>
  }
  
  profile mkdir @{bin}/mkdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,
    
    @{bin}/mkdir						mr,

    @{sys}/fs/cgroup/{openrc,unified}/kmod-static-nodes/ w,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }
  
  profile grep @{bin}/grep flags=(complain) {
    include <abstractions/base>

    @{bin}/grep						mr,

    @{sys}/fs/cgroup/unified/kmod-static-nodes/cgroup.procs r,

    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,    
  }
  
  profile rmdir @{bin}/rmdir flags=(complain) {
    include <abstractions/base>
    
    capability dac_override,

    @{bin}/rmdir						mr,

    @{sys}/fs/cgroup/unified/kmod-static-nodes/	w,
    
    /dev/tty@{int}					rw,
    /dev/console					rw,
    /dev/pts/@{int}					rw,
  }

  include if exists <local/kmod-static-nodes-sh>
}

# vim:syntax=apparmor
